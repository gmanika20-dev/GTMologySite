# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.
# Every key is optional: the site works without them (data saved locally in dev, emails logged instead of sent, booking via the built-in form).

NEXT_PUBLIC_SITE_URL=https://www.gtmologyai.com

# Booking — your Cal.com event path, e.g. manika-gupta/gtm-diagnostic (leave empty to use the built-in request form)
NEXT_PUBLIC_CAL_LINK=
CAL_WEBHOOK_SECRET=

# Database — Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email — Resend → API Keys (verify the gtmologyai.com domain in Resend first)
RESEND_API_KEY=
EMAIL_FROM=Manika at Dominize Consultancy <hello@gtmologyai.com>
OWNER_EMAIL=hello@gtmologyai.com

# Spam protection — Cloudflare Turnstile (optional)
TURNSTILE_SECRET_KEY=

# Tracking (public IDs, safe to expose). Loaded only after cookie consent.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_LINKEDIN_CONVERSION_ID=
